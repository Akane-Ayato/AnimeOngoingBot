# ---------- Telegram (my.telegram.org -> API development tools) ----------
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456:ABC-from-BotFather

# Owner user id(s), comma separated. Owners must press /start once so the bot can DM them alerts.
OWNER_ID=123456789
# Channel @username or numeric id (-100...). The bot must be an ADMIN with "Post messages".
CHANNEL_ID=@Anime_Void_x
# Optional extra place for error alerts (channel/group the bot is admin in)
LOG_CHANNEL=

# ---------- MongoDB ----------
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
DB_NAME=AnimeOngoingBot

# ---------- Site / API ----------
SITE_URL=https://ani-void-tv.vercel.app
API_BASE=https://anikotoapi.site
# If the upstream API fails, fall back to your site's own /api proxy
USE_SITE_FALLBACK=1

# ---------- Behaviour ----------
DEFAULT_INTERVAL=300
RECENT_PAGES=2
PER_PAGE=40
POST_DELAY=5

# ---------- Branding ----------
CHANNEL_NAME=Aɳιɱҽ Oɳɠσιɳɠ
POWERED_BY_NAME=𝙰𝚗𝚒𝚖𝚎 𝚅𝚘𝚒𝚍
POWERED_BY_URL=https://t.me/Index_void

# Start/help images, comma separated, one is picked at random each time
IMG=https://example.com/1.jpg,https://example.com/2.jpg,https://example.com/3.jpg

# ---------- Hosting ----------
PORT=8080
WEB_SERVER=1
# Render sets RENDER_EXTERNAL_URL automatically. On a VPS you may set PUBLIC_URL yourself.
# PUBLIC_URL=https://your-bot.onrender.com
# KEEP_ALIVE=1
